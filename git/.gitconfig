[core]
	pager = "if command -v nvim >/dev/null 2>&1 && command -v perl >/dev/null 2>&1; then perl -pe 's/\\033\\[[0-9;]*[mK]//g' | nvim -R -c 'set ft=diff' -; elif command -v diff-so-fancy >/dev/null 2>&1; then if command -v less >/dev/null 2>&1; then diff-so-fancy | less --tabs=4 -RF; else diff-so-fancy; fi; elif command -v less >/dev/null 2>&1; then less --tabs=4 -RF; else cat; fi"
	editor = nvim
[interactive]
	diffFilter = diff-so-fancy --patch
[merge]
	conflictStyle = diff3
	tool = nvimdiff
[user]
	email = zeltronsrikar@gmail.com
	name = 231tr0n
[init]
	defaultBranch = main
[pull]
	rebase = true
[color]
	ui = true
[color "diff-highlight"]
	oldNormal = red bold
	oldHighlight = red bold 52
	newNormal = green bold
	newHighlight = green bold 22
[color "diff"]
	meta = 11
	frag = magenta bold
	func = 146 bold
	commit = yellow bold
	old = red bold
	new = green bold
	whitespace = red reverse
[push]
	autoSetupRemote = true
